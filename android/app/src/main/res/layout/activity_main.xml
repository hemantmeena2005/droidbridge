<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#0F172A">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="DroidBridge"
        android:textColor="#38BDF8"
        android:textSize="26sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Secure local Android to macOS notification bridge"
        android:textColor="#94A3B8"
        android:textSize="13sp"
        android:layout_marginBottom="24dp" />

    <!-- Status Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#1E293B"
        android:padding="16dp"
        android:layout_marginBottom="16dp">

        <TextView
            android:id="@+id/tv_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Status: Disconnected"
            android:textColor="#F8FAFC"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_paired_mac"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Not paired with any Mac"
            android:textColor="#94A3B8"
            android:textSize="14sp"
            android:layout_marginTop="6dp" />
    </LinearLayout>

    <!-- Permission Button -->
    <Button
        android:id="@+id/btn_notification_settings"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="Grant Notification Access"
        android:backgroundTint="#2563EB"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="12dp" />

    <!-- Scan Button -->
    <Button
        android:id="@+id/btn_scan_qr"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="Scan Pairing QR Code"
        android:backgroundTint="#0284C7"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="12dp" />

    <!-- Connect Manual Button -->
    <Button
        android:id="@+id/btn_connect"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="Connect Now"
        android:backgroundTint="#059669"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="12dp" />

    <!-- Unpair Button -->
    <Button
        android:id="@+id/btn_unpair"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="Unpair Device"
        android:backgroundTint="#DC2626"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="24dp" />

    <!-- Settings & Filters -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Privacy &amp; Forwarding Rules"
        android:textColor="#E2E8F0"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <Switch
        android:id="@+id/switch_otp_only"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Forward OTPs Only (Drop regular notifications)"
        android:textColor="#CBD5E1"
        android:layout_marginBottom="16dp" />

    <!-- Test Trigger -->
    <Button
        android:id="@+id/btn_test_notification"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="Test OTP Detection Engine"
        android:backgroundTint="#334155"
        android:textColor="#E2E8F0" />

</LinearLayout>
